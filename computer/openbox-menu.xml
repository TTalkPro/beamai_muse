  <menu id="root-menu" label="Openbox 3">
    <item label="Terminal"><action name="Execute"><execute>xterm</execute></action></item>
    <item label="LibreOffice Writer"><action name="Execute"><execute>soffice --writer</execute></action></item>
    <item label="LibreOffice Calc"><action name="Execute"><execute>soffice --calc</execute></action></item>
    <separator />
    <item label="Reconfigure"><action name="Reconfigure" /></item>
  </menu>
</openbox_menu>
