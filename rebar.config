%% beamai_muse umbrella: an Erlang reimplementation of OpenMuse.
%%
%%   apps/muse_core    config, storage (Mnesia + bitcask), security primitives
%%   apps/muse_integ   workspace, files/PDF, computer, browser, Google
%%   apps/muse_engine  durable task engine, approvals, monitors, goals, ideas
%%   apps/muse_agent   models, tools, chat and task agents, threads, search
%%   apps/muse_web     cowboy: JSON API, AG-UI endpoint, aihtml UI
%%
%% Dependencies are fetched over https from GitHub; rebar.lock pins the exact
%% commits. Upgrade with `rebar3 upgrade --all` and review the lock diff.
{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info,
            warnings_as_errors,
            warn_export_vars,
            warn_shadow_vars,
            warn_obsolete_guard,
            warn_unused_import,
            warn_untyped_record]}.

{deps, [{beamai_core, {git_subdir, "https://github.com/TTalkPro/beamai.git",
                       {branch, "main"}, "apps/beamai_core"}},
        {beamai_llm, {git_subdir, "https://github.com/TTalkPro/beamai.git",
                      {branch, "main"}, "apps/beamai_llm"}},
        {beamai_agent, {git_subdir, "https://github.com/TTalkPro/beamai.git",
                        {branch, "main"}, "apps/beamai_agent"}},
        {beamai_tools, {git_subdir, "https://github.com/TTalkPro/beamai_extra.git",
                        {branch, "main"}, "apps/beamai_tools"}},
        {beamai_mcp, {git_subdir, "https://github.com/TTalkPro/beamai_extra.git",
                      {branch, "main"}, "apps/beamai_mcp"}},
        {beamai_agui, {git_subdir, "https://github.com/TTalkPro/beamai_extra.git",
                       {branch, "main"}, "apps/beamai_agui"}},
        {aihtml, {git_subdir, "https://github.com/DavidAlphaFox/aihtml.git",
                  {branch, "master"}, "apps/aihtml"}},
        {aihtml_cowboy, {git_subdir, "https://github.com/DavidAlphaFox/aihtml.git",
                         {branch, "master"}, "apps/aihtml_cowboy"}},
        %% C++23 NIF; its pre_hooks init the libbitcask submodule and run cmake
        %% (needs cmake, a C++23 compiler and ICU headers).
        {bitcask, {git, "https://github.com/DavidAlphaFox/bitcask.git",
                   {branch, "develop"}}},
        {gun, "2.7.0"},
        {cowboy, "2.13.0"},
        {erlexec, "2.5.0"}]}.

{project_app_dirs, ["apps/*"]}.

{shell, [{apps, [muse_web]},
         {config, "config/shell.config"}]}.

{dialyzer, [{warnings, [unmatched_returns, error_handling, unknown]},
            {plt_extra_apps, [mnesia, cowboy, cowlib, ranch, gun]}]}.

{xref_checks, [undefined_function_calls, undefined_functions,
               locals_not_used, deprecated_function_calls,
               deprecated_functions]}.

{relx, [{release, {beamai_muse, "0.1.0"},
         [muse_web,
          %% Loaded, not started: muse_store creates the disc schema and
          %% starts mnesia itself.
          {mnesia, load},
          sasl]},
        {sys_config_src, "config/sys.config.src"},
        {vm_args_src, "config/vm.args.src"},
        {dev_mode, true},
        {include_erts, false},
        {extended_start_script, true}]}.

{profiles, [{test, [{deps, [{meck, "1.2.0"}]},
                    {erl_opts, [nowarn_export_all]}]},
            {prod, [{relx, [{dev_mode, false},
                            {include_erts, true},
                            {include_src, false}]}]}]}.
