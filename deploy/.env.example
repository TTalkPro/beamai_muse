# beamai_muse deployment configuration. scripts/deploy.sh writes <app>/.env
# from this file on the first install (fresh secrets, absolute paths); edit
# that copy, then `bin/muse restart`. Variables are described in README §配置.

WORKSPACE_MODE=live
OPENMUSE_ACCESS_KEY=@ACCESS_KEY@
TOKEN_ENCRYPTION_KEY=@ENCRYPTION_KEY@
MUSE_UI_SECRET=@UI_SECRET@

HOST=0.0.0.0
PORT=8787
PUBLIC_API_URL=http://127.0.0.1:8787
# Origins allowed besides PUBLIC_API_URL's: a comma-separated list, or * for any.
ALLOWED_ORIGINS=*
# TRUST_PROXY=true

# The release starts in <app>/rel, so paths here must be absolute.
DATA_DIR=@APP_DIR@/data
PDF_SIDECAR=node @APP_DIR@/sidecars/pdf/index.mjs
MAIL_SIDECAR=node @APP_DIR@/sidecars/mail/index.mjs

# Erlang node, read by bin/muse. Mnesia data is tied to the node name:
# do not change it after the first start.
MUSE_NODE_NAME=muse_app@127.0.0.1
MUSE_COOKIE=@COOKIE@

# Model: MODEL=<provider>/<model-id>. For an OpenAI-compatible gateway use
# openai/<id> with OPENAI_BASE_URL and OPENAI_CHAT_COMPLETIONS=true.
AGENT_BACKEND=sample
# AGENT_BACKEND=model
# MODEL=anthropic/claude-sonnet-4.5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_CHAT_COMPLETIONS=true

# Model steps per chat reply; a reply runs until it is done or stopped.
# CHAT_MAX_STEPS=200
# TASK_MAX_STEPS=50
# TASK_RUN_MINUTES=10
# TASK_AUTO_RUNS=10

WEB_SEARCH_ENABLED=true
# PARALLEL_API_KEY=

# Browser worker (sidecars/browser-worker, started by bin/muse when set).
BROWSER_WORKER_URL=http://127.0.0.1:8790
WORKER_TOKEN=@WORKER_TOKEN@

# Docker computer: `make computer-image` / `make computer-desktop-image`.
COMPUTER_ENABLED=false
# COMPUTER_PROVIDER=docker
# COMPUTER_DESKTOP=true
# Network of the computers: bridge (default; Docker's bridge network, internet
# and the host's LAN reachable) or none (no network, as in OpenMuse).
# COMPUTER_NETWORK=bridge
# Computer pool: one computer per conversation and per background task.
# Running computers per deployment (the least recently used idle one is
# stopped to start another), idle minutes before a computer is stopped, and
# days a stopped, unused conversation/task computer is kept before deletion.
# COMPUTER_MAX_RUNNING=4
# COMPUTER_IDLE_MINUTES=15
# COMPUTER_RETENTION_DAYS=7

# Files: the largest file one upload may store, in MB (any type; PDFs stay
# at 10 MB).
# FILES_MAX_MB=25

# Built-in mail (邮件): the window kept of each folder (the last
# MAIL_SYNC_DAYS days, at most MAIL_SYNC_MAX messages) and the polling
# interval in minutes (IMAP IDLE delivers new inbox mail sooner).
# Attachments are limited by FILES_MAX_MB. Mailbox passwords are encrypted
# with TOKEN_ENCRYPTION_KEY: changing that key means retyping them.
# MAIL_SYNC_DAYS=30
# MAIL_SYNC_MAX=500
# MAIL_POLL_MINUTES=5

# Jev: off, sample or live (TYPESAFE_API_KEY, TYPESAFE_BASE_URL, JEV_MODEL).
# JEV_MODE=off
