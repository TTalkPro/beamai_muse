#!/bin/sh
# Control script of a deployed beamai_muse; scripts/deploy.sh installs it as
# <app>/bin/muse. Runs the release in <app>/rel with <app>/.env and, when
# BROWSER_WORKER_URL is set there, the WebChat/CDP browser worker container.
#
#   bin/muse start | stop | restart | status   both processes, in the background
#   bin/muse foreground                        release only, attached (systemd)
#   bin/muse worker-foreground                 browser worker only, attached (systemd)
#   bin/muse remote                            remote shell into the running node
#   bin/muse logs                              follow the release and worker logs
set -eu
APP_DIR="$(cd "$(dirname "$0")/.." && pwd -P)"
REL="$APP_DIR/rel/bin/beamai_muse"
ENV_FILE="$APP_DIR/.env"
RUN_DIR="$APP_DIR/run"
LOG_DIR="$APP_DIR/logs"
WORKER_PID="$RUN_DIR/browser-worker.pid"

[ -f "$ENV_FILE" ] || { echo "missing $ENV_FILE" >&2; exit 1; }
[ -x "$REL" ] || { echo "missing release $REL (run scripts/deploy.sh)" >&2; exit 1; }

# Last KEY=value in .env, outer quotes removed (muse_config reads the full file).
env_value() {
    sed -n "s/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}$1[[:space:]]*=[[:space:]]*//p" "$ENV_FILE" |
        tail -n 1 | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

export MUSE_ENV_FILE="$ENV_FILE"
node_name=$(env_value MUSE_NODE_NAME)
cookie=$(env_value MUSE_COOKIE)
[ -z "$node_name" ] || export MUSE_NODE_NAME="$node_name"
[ -z "$cookie" ] || export MUSE_COOKIE="$cookie"
export RELX_OUT_FILE_PATH="$RUN_DIR"
mkdir -p "$RUN_DIR" "$LOG_DIR"

worker_enabled() { [ -n "$(env_value BROWSER_WORKER_URL)" ]; }

worker_env() {
    WORKER_TOKEN=$(env_value WORKER_TOKEN)
    data_dir=$(env_value DATA_DIR)
    WORKER_DATA_DIR="${data_dir:-$APP_DIR/data}/browser-profiles"
    export WORKER_TOKEN WORKER_DATA_DIR
}

worker_running() {
    [ -f "$WORKER_PID" ] && kill -0 "$(cat "$WORKER_PID")" 2>/dev/null
}

worker_start() {
    worker_enabled || return 0
    if worker_running; then echo "browser worker already running"; return 0; fi
    worker_env
    # Own process group, so stop also reaches the node child of npx/tsx.
    setsid nohup "$APP_DIR/scripts/run-browser-worker.sh" >>"$LOG_DIR/browser-worker.log" 2>&1 &
    echo $! >"$WORKER_PID"
    echo "browser worker started (pid $(cat "$WORKER_PID"))"
}

worker_stop() {
    if worker_running; then
        pid=$(cat "$WORKER_PID")
        # `env kill`: dash's builtin cannot signal a process group.
        env kill -TERM -- "-$pid" 2>/dev/null || true
        i=0
        while env kill -0 -- "-$pid" 2>/dev/null && [ $i -lt 50 ]; do sleep 0.2; i=$((i + 1)); done
        env kill -KILL -- "-$pid" 2>/dev/null || true
        echo "browser worker stopped"
    fi
    rm -f "$WORKER_PID"
}

release_running() { "$REL" ping >/dev/null 2>&1; }

release_start() {
    if release_running; then echo "muse already running"; return 0; fi
    "$REL" daemon
    i=0
    until release_running; do
        i=$((i + 1))
        if [ $i -gt 60 ]; then
            echo "muse did not come up; see $APP_DIR/rel/log/ and bin/muse logs" >&2
            exit 1
        fi
        sleep 0.5
    done
    echo "muse started on $(env_value PUBLIC_API_URL)"
}

release_stop() {
    if release_running; then "$REL" stop >/dev/null && echo "muse stopped"; fi
}

case "${1:-}" in
    start) worker_start; release_start ;;
    stop) release_stop; worker_stop ;;
    restart) release_stop; worker_stop; worker_start; release_start ;;
    status)
        if release_running; then echo "muse: running"; else echo "muse: stopped"; fi
        if worker_enabled; then
            if worker_running; then echo "browser worker: running (pid $(cat "$WORKER_PID"))"
            else echo "browser worker: stopped"; fi
        fi ;;
    foreground) exec "$REL" foreground ;;
    worker-foreground) worker_env; exec "$APP_DIR/scripts/run-browser-worker.sh" ;;
    remote) exec "$REL" remote_console ;;
    logs) exec tail -n 100 -F "$APP_DIR"/rel/log/erlang.log.* "$LOG_DIR/browser-worker.log" ;;
    *) echo "usage: $0 start|stop|restart|status|foreground|worker-foreground|remote|logs" >&2; exit 2 ;;
esac
