#!/bin/sh
# Control script of a deployed beamai_muse; scripts/deploy.sh installs it as
# <app>/bin/muse. Runs the release in <app>/rel with <app>/.env. The browser
# needs no process here: with BROWSER_ENABLED=true muse starts each user's
# Chrome container itself (make browser-image).
#
#   bin/muse start | stop | restart | status   the release, in the background
#   bin/muse foreground                        attached (systemd)
#   bin/muse remote                            remote shell into the running node
#   bin/muse logs                              follow the release log
set -eu
APP_DIR="$(cd "$(dirname "$0")/.." && pwd -P)"
REL="$APP_DIR/rel/bin/beamai_muse"
ENV_FILE="$APP_DIR/.env"
RUN_DIR="$APP_DIR/run"
LOG_DIR="$APP_DIR/logs"

[ -f "$ENV_FILE" ] || { echo "missing $ENV_FILE" >&2; exit 1; }
[ -x "$REL" ] || { echo "missing release $REL (run scripts/deploy.sh)" >&2; exit 1; }

# Last KEY=value in .env, outer quotes removed (muse_config reads the full file).
env_value() {
    sed -n "s/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}$1[[:space:]]*=[[:space:]]*//p" "$ENV_FILE" |
        tail -n 1 | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

export MUSE_ENV_FILE="$ENV_FILE"
node_name=$(env_value MUSE_NODE_NAME)
cookie=$(env_value MUSE_COOKIE)
[ -z "$node_name" ] || export MUSE_NODE_NAME="$node_name"
[ -z "$cookie" ] || export MUSE_COOKIE="$cookie"
export RELX_OUT_FILE_PATH="$RUN_DIR"
mkdir -p "$RUN_DIR" "$LOG_DIR"

# The browser worker of older versions (Playwright, then the WebChat/CDP
# worker container; replaced by the per-user Chrome containers that muse
# starts itself): stopped if one is left over.
legacy_worker_stop() {
    pid_file="$RUN_DIR/browser-worker.pid"
    if [ -f "$pid_file" ]; then
        pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
            # `env kill`: dash's builtin cannot signal a process group.
            env kill -TERM -- "-$pid" 2>/dev/null || true
            i=0
            while env kill -0 -- "-$pid" 2>/dev/null && [ $i -lt 50 ]; do sleep 0.2; i=$((i + 1)); done
            env kill -KILL -- "-$pid" 2>/dev/null || true
            echo "old browser worker stopped"
        fi
        rm -f "$pid_file"
    fi
}

release_running() { "$REL" ping >/dev/null 2>&1; }

release_start() {
    if release_running; then echo "muse already running"; return 0; fi
    "$REL" daemon
    i=0
    until release_running; do
        i=$((i + 1))
        if [ $i -gt 60 ]; then
            echo "muse did not come up; see $APP_DIR/rel/log/ and bin/muse logs" >&2
            exit 1
        fi
        sleep 0.5
    done
    echo "muse started on $(env_value PUBLIC_API_URL)"
}

release_stop() {
    if release_running; then "$REL" stop >/dev/null && echo "muse stopped"; fi
}

case "${1:-}" in
    start) legacy_worker_stop; release_start ;;
    stop) release_stop; legacy_worker_stop ;;
    restart) release_stop; legacy_worker_stop; release_start ;;
    status) if release_running; then echo "muse: running"; else echo "muse: stopped"; fi ;;
    foreground) exec "$REL" foreground ;;
    remote) exec "$REL" remote_console ;;
    logs) exec tail -n 100 -F "$APP_DIR"/rel/log/erlang.log.* ;;
    *) echo "usage: $0 start|stop|restart|status|foreground|remote|logs" >&2; exit 2 ;;
esac
