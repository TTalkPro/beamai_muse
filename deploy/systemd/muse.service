# beamai_muse release. Paths assume APP_DIR=/home/david/app/muse; deploy.sh
# writes a copy adjusted to its APP_DIR and user into APP_DIR/systemd/.
#
#   sudo cp APP_DIR/systemd/*.service /etc/systemd/system/
#   APP_DIR/bin/muse stop            # if started with the shell script
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now muse-browser-worker.service muse.service
#
# Use either systemd or bin/muse start/stop, not both at once.
[Unit]
Description=beamai_muse (OpenMuse in Erlang)
After=network-online.target docker.service muse-browser-worker.service
Wants=network-online.target muse-browser-worker.service

[Service]
Type=simple
User=david
Group=david
WorkingDirectory=/home/david/app/muse
ExecStart=/home/david/app/muse/bin/muse foreground
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
